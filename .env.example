# SokoYetu Backend Environment Variables
# Copy this file, fill in your real values, save as .env

# Supabase PostgreSQL connection string
# Get this from: Supabase Dashboard → Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# JWT Secret — make this a long random string, e.g. sokoyetu_secret_2026_rwanda
JWT_SECRET=sokoyetu_secret_change_this_to_something_long_and_random

# Your deployed frontend URL (update after Vercel deployment)
FRONTEND_URL=https://sokoyetu.vercel.app

# Port (Railway sets this automatically)
PORT=5000
